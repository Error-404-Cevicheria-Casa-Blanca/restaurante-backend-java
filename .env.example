# Variables de entorno del backend (valores de ejemplo FALSOS).
# Spring Boot NO lee .env por si solo: exporta estas variables en PowerShell
# antes de arrancar. Ver README.md (seccion "Como ejecutar").

DB_URL=jdbc:postgresql://localhost:5432/lacasablanca
DB_USER=usuario_ejemplo
DB_PASSWORD=cambiar_esto
JWT_SECRET=cambiar_esto_por_un_secreto_largo
JWT_EXPIRATION_MS=86400000
