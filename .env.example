# ==============================================================================
# CONFIGURACION DE PRODUCCION — RESTAURANTE CASA BLANCA (PC CENTRAL LAN)
# Copie este archivo a .env y configure las variables de entorno del sistema
# o en el wrapper NSSM del servicio Windows CasaBlancaBackendJava.
# ==============================================================================

# 1. Base de datos PostgreSQL 16 (Local en PC Central)
DB_URL=jdbc:postgresql://localhost:5432/casablanca
DB_USER=postgres
DB_PASSWORD=REEMPLAZAR_CON_PASSWORD_SEGURO_PRODUCCION

# 2. Seguridad JWT (Minimo 32 caracteres / 256 bits para HMAC-SHA256)
# Expiracion de turno operativo: 43200000 ms (12 horas)
JWT_SECRET=REEMPLAZAR_CON_SECRETO_HMAC_SHA256_DE_AL_MENOS_32_BYTES_PRODUCCION
JWT_EXPIRATION_MS=43200000

# 3. Hardening CORS (Solo origenes autorizados en la LAN de Casa Blanca)
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://192.168.1.10:8000

# 4. Directorio de Logs Rotativos (RollingFileAppender 10MB x 30 dias, tope 500MB)
LOG_PATH=C:/CasaBlanca/logs
